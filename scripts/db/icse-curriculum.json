            { "title": "Reading and Comprehension", "chapters": ["Sight words", "Reading short sentences", "Story time: picture reading", "Answering simple questions", "Reading aloud practice"] },
            { "title": "Grammar Basics", "chapters": ["Naming words (nouns)", "Action words (verbs)", "Describing words (adjectives)", "One and many", "a, an, the"] },
            { "title": "Writing Skills", "chapters": ["Tracing and copying", "Writing words and sentences", "Capital letters and full stops", "Picture composition", "My first paragraph"] }
          ]
        },
        {
          "name": "Mathematics", "code": "MATH",
