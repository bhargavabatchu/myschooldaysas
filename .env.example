# Development-only values. Never copy these to production.
# Optional integrations default to enabled to preserve the development classroom.
# For a core-only release, set all three to false in PRODUCTION settings.
ENABLE_LIVE_CLASSES=true
ENABLE_ONLINE_PAYMENTS=true
ENABLE_REDIS=true
# These public build-time settings must match the API flags.
NEXT_PUBLIC_ENABLE_LIVE_CLASSES=true
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENTS=true
DATABASE_URL=postgres://campus_app:campus_app@127.0.0.1:5432/campus
# Production only: add a restricted runtime connection as the CAMPUS_DATABASE_URL secret.
# Do not point it at the platform-managed owner connection.
# CAMPUS_DATABASE_URL=
MIGRATOR_DATABASE_URL=postgres://campus_migrator:migrator_dev_only@127.0.0.1:5432/campus
# Supabase Auth (required): the API verifies Supabase-issued access tokens via JWKS
# and manages auth.users through the Admin API with the service role key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<service-role-key>
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Web client (browser) publishable credentials:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
INTERNAL_API_KEY=replace-with-a-random-key-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NODE_ENV=development
PORT=8080
